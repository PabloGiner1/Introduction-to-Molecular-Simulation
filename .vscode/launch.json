{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar simulacion y analizar",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/simulation",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Compilar TFIII",
            "postDebugTask": "Analizar resultados",
            "windows": {
                "program": "${workspaceFolder}/bin/simulation.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
                "externalConsole": false,
                "avoidWindowsConsoleRedirection": false,
                "environment": [
                    {
                        "name": "PATH",
                        "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                ]
            },
            "osx": {
                "program": "${workspaceFolder}/bin/simulation",
                "MIMode": "lldb"
            }
        }
    ]
}