{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Preparar carpetas",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "windows": {
                "command": "C:\\Users\\hugos\\anaconda3\\python.exe"
            },
            "args": [
                "-c",
                "from pathlib import Path; folders=['bin','data/raw/harmonic','data/raw/random','data/raw/polymer','results/harmonic/single_run/figures','results/harmonic/time_convergence/tables','results/harmonic/time_convergence/figures','results/harmonic/algorithm_comparison/tables','results/harmonic/algorithm_comparison/figures','results/random_test/figures','results/double_well/force_sweep/tables','results/double_well/force_sweep/figures','results/polymer/single_run/figures']; [Path(p).mkdir(parents=True, exist_ok=True) for p in folders]"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Compilar TFIII",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/simulation.cpp",
                "${workspaceFolder}/src/models.cpp",
                "${workspaceFolder}/src/integrators.cpp",
                "${workspaceFolder}/src/polymer.cpp",
                "${workspaceFolder}/src/polymer_simulation.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/bin/simulation"
            ],
            "windows": {
                "command": "g++",
                "args": [
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-Wpedantic",
                    "-g",
                    "${workspaceFolder}/src/main.cpp",
                    "${workspaceFolder}/src/simulation.cpp",
                    "${workspaceFolder}/src/models.cpp",
                    "${workspaceFolder}/src/integrators.cpp",
                    "${workspaceFolder}/src/polymer.cpp",
                    "${workspaceFolder}/src/polymer_simulation.cpp",
                    "-I${workspaceFolder}/include",
                    "-o",
                    "${workspaceFolder}/bin/simulation.exe"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Preparar carpetas"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
