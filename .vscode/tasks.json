{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar TFIII",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/simulation.cpp",
                "${workspaceFolder}/src/models.cpp",
                "${workspaceFolder}/src/integrators.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/bin/simulation"
            ],
            "windows": {
                "command": "g++"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}